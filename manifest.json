{
  "manifest_version": 3,
  "name": "TrustMeBro Fact Checker",
  "version": "2.0",
  "description": "Phân tích độ tin cậy của nội dung với AI và giao diện thân thiện",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["*://localhost/*", "https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/trust_check_logo-removebg-preview.png",
      "48": "icons/trust_check_logo-removebg-preview.png",
      "128": "icons/trust_check_logo-removebg-preview.png"
    }
  },
  "icons": {
    "16": "icons/trust_check_logo-removebg-preview.png",
    "48": "icons/trust_check_logo-removebg-preview.png",
    "128": "icons/trust_check_logo-removebg-preview.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
