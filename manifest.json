{
  "manifest_version": 3,
  "name": "TrustMe Data Collector",
  "version": "1.0",
  "description": "Thu thập nhanh dữ liệu bài viết và bài đăng dưới dạng JSON",
  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["*://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
